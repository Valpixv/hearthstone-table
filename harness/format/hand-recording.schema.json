{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthstone-table.local/schemas/hand-recording-v1.json",
  "title": "HandRecording v1 (canonical form)",
  "description": "Documentation schema. The authoritative validator is harness/format/recording.js (validateRecording), which also accepts the packed encoding and checks quaternion norms, joint completeness and strictly increasing timestamps.",
  "type": "object",
  "required": ["version", "source", "fps", "frames"],
  "properties": {
    "version": { "const": 1 },
    "source": { "enum": ["webxr", "mediapipe", "synthetic"] },
    "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
    "meta": { "type": "object" },
    "encoding": {
      "type": "object",
      "description": "Present only in packed files; see recording.js",
      "required": ["type", "decimals", "delta", "joints", "fields"],
      "properties": {
        "type": { "const": "packed" },
        "decimals": { "type": "integer", "minimum": 1, "maximum": 8 },
        "delta": { "type": "boolean" },
        "joints": { "type": "array", "items": { "type": "string" }, "minItems": 25, "maxItems": 25 },
        "fields": { "const": ["px", "py", "pz", "qx", "qy", "qz", "qw", "r"] }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "left": { "$ref": "#/$defs/hand" },
          "right": { "$ref": "#/$defs/hand" }
        }
      }
    }
  },
  "$defs": {
    "joint": {
      "type": "object",
      "required": ["p", "q", "r"],
      "properties": {
        "p": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "q": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "r": { "type": "number", "minimum": 0, "maximum": 0.1 }
      }
    },
    "hand": {
      "type": "object",
      "required": [
        "wrist",
        "thumb-metacarpal", "thumb-phalanx-proximal", "thumb-phalanx-distal", "thumb-tip",
        "index-finger-metacarpal", "index-finger-phalanx-proximal", "index-finger-phalanx-intermediate", "index-finger-phalanx-distal", "index-finger-tip",
        "middle-finger-metacarpal", "middle-finger-phalanx-proximal", "middle-finger-phalanx-intermediate", "middle-finger-phalanx-distal", "middle-finger-tip",
        "ring-finger-metacarpal", "ring-finger-phalanx-proximal", "ring-finger-phalanx-intermediate", "ring-finger-phalanx-distal", "ring-finger-tip",
        "pinky-finger-metacarpal", "pinky-finger-phalanx-proximal", "pinky-finger-phalanx-intermediate", "pinky-finger-phalanx-distal", "pinky-finger-tip"
      ],
      "additionalProperties": { "$ref": "#/$defs/joint" }
    }
  }
}
